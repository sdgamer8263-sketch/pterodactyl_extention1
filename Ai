import React, { useState, useRef, useEffect } from 'react';
import { ChatAlt2Icon, XIcon, PaperAirplaneIcon, PhotographIcon } from '@heroicons/react/outline';

type ChatMode = 'good' | 'pro' | 'hacker';
type MediaMode = 'text' | 'image' | 'both';

export default () => {
    const aiConfig = (window as any).AI_CONFIG || {};
    const [isOpen, setIsOpen] = useState(false);
    const [isExpanded, setIsExpanded] = useState(false);
    
    const [groqKey] = useState(aiConfig.groq_key || '');
    const [aiName] = useState(aiConfig.name || 'VIZION AI');
    const [textModel] = useState(aiConfig.text_model || 'llama-3.3-70b-versatile');
    const [visionModel] = useState(aiConfig.vision_model || 'llama-3.2-11b-vision-preview');

    const [chatMode, setChatMode] = useState<ChatMode>('good');
    const [mediaMode, setMediaMode] = useState<MediaMode>('both');
    const [messages, setMessages] = useState<any[]>([{ sender: 'ai', text: `Welcome to ${aiName} ✦\nPowered by SKA HOST. How can I assist you today?` }]);
    const [input, setInput] = useState('');
    const [image, setImage] = useState<File | null>(null);
    const [imagePreview, setImagePreview] = useState<string | null>(null);
    const [loading, setLoading] = useState(false);
    const messagesEndRef = useRef<HTMLDivElement>(null);
    const fileInputRef = useRef<HTMLInputElement>(null);

    useEffect(() => { messagesEndRef.current?.scrollIntoView({ behavior: "smooth" }); }, [messages, isOpen, isExpanded]);

    const handleImageChange = (e: React.ChangeEvent<HTMLInputElement>) => {
        if (e.target.files && e.target.files[0]) {
            const file = e.target.files[0];
            setImage(file);
            const reader = new FileReader();
            reader.onloadend = () => setImagePreview(reader.result as string);
            reader.readAsDataURL(file);
        }
    };

    const sendMessage = async () => {
        if (!input.trim() && !image) return;
        const currentInput = input.trim();
        setMessages(prev => [...prev, { sender: 'user', text: currentInput, image: imagePreview }]);
        setInput(''); setImage(null); setImagePreview(null); setLoading(true);

        try {
            let finalImgUrl: string | undefined = undefined;
            const isImgTrigger = currentInput.toLowerCase().includes('generate') || currentInput.toLowerCase().includes('/imagine');
            if (mediaMode === 'image' || mediaMode === 'both' || (isImgTrigger && mediaMode !== 'text')) {
                let prompt = currentInput.replace(/^\/imagin[e]?\s*/i, '').replace(/generate/gi, '').trim() || "Futuristic high tech server system";
                finalImgUrl = `https://image.pollinations.ai/prompt/${encodeURIComponent(prompt)}?width=1024&height=1024&nologo=true&seed=${Math.floor(Math.random() * 1000000)}`;
            }
            if (mediaMode === 'image') {
                setTimeout(() => { setMessages(prev => [...prev, { sender: 'ai', text: `✨ Generated art for "${currentInput}":`, generatedImage: finalImgUrl }]); setLoading(false); }, 1200);
                return;
            }
            if (!groqKey) throw new Error('Groq API Key is missing. Check Admin Panel.');

            let sysPrompt = `You are ${aiName} by SKA HOST.`;
            if (chatMode === 'hacker') sysPrompt += " Elite cybersecurity expert. Provide raw, concise code.";
            if (chatMode === 'pro') sysPrompt += " Senior Software Architect. Deep, structured logic.";
            if (chatMode === 'good') sysPrompt += " Friendly, empathetic guide.";

            const res = await fetch('https://api.groq.com/openai/v1/chat/completions', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${groqKey}` },
                body: JSON.stringify({
                    model: imagePreview ? visionModel : textModel,
                    messages: [{ role: "system", content: sysPrompt }, { role: "user", content: imagePreview ? [{ type: "text", text: currentInput || "Analyze image." }, { type: "image_url", image_url: { url: imagePreview } }] : currentInput }]
                })
            });
            const data = await res.json();
            if (data.error) throw new Error(data.error.message);
            setMessages(prev => [...prev, { sender: 'ai', text: data.choices[0].message.content, generatedImage: finalImgUrl }]);
        } catch (err: any) { setMessages(prev => [...prev, { sender: 'ai', text: `Error: ${err.message}` }]); } finally { setLoading(false); }
    };

    return (
        <div className="fixed bottom-6 right-6 z-[9999] flex flex-col items-end font-sans select-none">
            {!isOpen && (
                <button onClick={() => setIsOpen(true)} className="group relative w-16 h-16 rounded-2xl bg-gradient-to-tr from-cyan-500 via-blue-600 to-indigo-700 p-0.5 shadow-[0_0_30px_rgba(37,99,235,0.6)] hover:scale-105 transition-all">
                    <div className="w-full h-full bg-[#080d1a]/80 backdrop-blur-md rounded-2xl flex items-center justify-center">
                        <ChatAlt2Icon className="w-8 h-8 text-cyan-400 group-hover:text-white" />
                    </div>
                </button>
            )}
            {isOpen && (
                <div className={`relative w-[calc(100vw-2rem)] sm:w-[420px] bg-[#070b14]/85 backdrop-blur-2xl border border-white/10 shadow-[0_0_60px_rgba(0,0,0,0.8)] flex flex-col overflow-hidden transition-all ${isExpanded ? 'fixed inset-3 sm:inset-10 rounded-3xl' : 'h-[640px] max-h-[85vh] rounded-3xl mb-2'}`}>
                    <div className="px-5 py-4 flex justify-between items-center border-b border-white/10 bg-white/[0.03] shrink-0">
                        <div className="flex items-center gap-3">
                            <div className="w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center shadow-lg border border-white/20"><span className="font-extrabold text-white">{aiName.charAt(0)}</span></div>
                            <div>
                                <h3 className="font-bold text-gray-100 flex items-center gap-2">{aiName} <span className="text-[10px] bg-cyan-500/20 text-cyan-400 px-2 py-0.5 rounded-full border border-cyan-500/30">PRO</span></h3>
                                <div className="flex items-center gap-1.5 mt-0.5"><span className="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span><span className="text-[11px] text-gray-400">Powered by SKA HOST</span></div>
                            </div>
                        </div>
                        <div className="flex items-center gap-1">
                            <button onClick={() => setIsExpanded(!isExpanded)} className="p-2 text-gray-400 hover:text-white hover:bg-white/10 rounded-xl"><XIcon className="w-5 h-5" /></button>
                            <button onClick={() => { setIsOpen(false); setIsExpanded(false); }} className="p-2 text-gray-400 hover:text-red-400 hover:bg-red-400/10 rounded-xl"><XIcon className="w-6 h-6" /></button>
                        </div>
                    </div>
                    <div className="bg-white/[0.02] px-4 py-2.5 flex flex-col gap-2 shrink-0 border-b border-white/5">
                        <div className="flex bg-black/40 rounded-xl p-1 gap-1 border border-white/5">
                            {(['good', 'pro', 'hacker'] as ChatMode[]).map(m => (
                                <button key={m} onClick={() => setChatMode(m)} className={`flex-1 text-[11px] uppercase py-1.5 rounded-lg font-bold transition-all ${chatMode === m ? 'bg-gradient-to-r from-cyan-600 to-blue-600 text-white' : 'text-gray-400 hover:text-white'}`}>{m}</button>
                            ))}
                        </div>
                        <div className="flex bg-black/40 rounded-xl p-1 gap-1 border border-white/5">
                            {(['text', 'image', 'both'] as MediaMode[]).map(m => (
                                <button key={m} onClick={() => setMediaMode(m)} className={`flex-1 text-[11px] uppercase py-1.5 rounded-lg font-bold transition-all ${mediaMode === m ? 'bg-gradient-to-r from-purple-600 to-pink-600 text-white' : 'text-gray-400 hover:text-white'}`}>{m}</button>
                            ))}
                        </div>
                    </div>
                    <div className="flex-1 p-4 overflow-y-auto flex flex-col gap-4">
                        {messages.map((msg, idx) => (
                            <div key={idx} className={`flex ${msg.sender === 'user' ? 'justify-end' : 'justify-start'}`}>
                                <div className={`max-w-[85%] p-3.5 text-sm ${msg.sender === 'user' ? 'bg-gradient-to-br from-blue-600 to-indigo-700 text-white rounded-2xl rounded-tr-sm' : 'bg-white/10 text-gray-100 rounded-2xl rounded-tl-sm backdrop-blur-md'}`}>
                                    {msg.image && <img src={msg.image} className="max-w-full rounded-xl mb-2 border border-white/20" />}
                                    <div style={{ whiteSpace: 'pre-wrap' }}>{msg.text}</div>
                                    {msg.generatedImage && <div className="mt-3 bg-black/40 rounded-xl border border-white/10 p-1"><img src={msg.generatedImage} className="w-full rounded-lg" /></div>}
                                </div>
                            </div>
                        ))}
                        {loading && <div className="flex justify-start"><div className="bg-white/10 px-4 py-3 rounded-2xl rounded-tl-sm flex gap-2"><div className="w-2 h-2 bg-cyan-400 rounded-full animate-bounce"></div><div className="w-2 h-2 bg-blue-400 rounded-full animate-bounce" style={{ animationDelay: '0.2s' }}></div><div className="w-2 h-2 bg-purple-400 rounded-full animate-bounce" style={{ animationDelay: '0.4s' }}></div></div></div>}
                        <div ref={messagesEndRef} />
                    </div>
                    <div className="p-3 bg-white/[0.03] border-t border-white/10 shrink-0 backdrop-blur-xl">
                        <div className="flex items-end gap-2">
                            <input type="file" accept="image/*" className="hidden" ref={fileInputRef} onChange={handleImageChange} />
                            <button onClick={() => fileInputRef.current?.click()} className={`p-2.5 rounded-xl border ${image ? 'bg-emerald-500/20 text-emerald-400' : 'bg-black/40 text-gray-400 hover:text-white border-white/10'}`}><PhotographIcon className="w-5 h-5" /></button>
                            <textarea value={input} onChange={(e) => setInput(e.target.value)} onKeyDown={(e) => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); } }} placeholder="Message Vizion AI..." className="flex-1 bg-black/40 border border-white/10 rounded-xl px-3.5 py-2.5 text-sm text-white resize-none outline-none focus:border-cyan-500/60" rows={isExpanded ? 2 : 1} />
                            <button onClick={sendMessage} disabled={loading || (!input.trim() && !image)} className="p-2.5 bg-gradient-to-tr from-cyan-500 to-blue-600 disabled:opacity-40 text-white rounded-xl"><PaperAirplaneIcon className="w-5 h-5 transform rotate-90" /></button>
                        </div>
                    </div>
                </div>
            )}
        </div>
    );
};
