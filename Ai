cat << 'EOF' > /var/www/pterodactyl/resources/scripts/components/AiChatWidget.tsx
import React, { useState, useRef, useEffect } from 'react';
import { ChatAlt2Icon, XIcon, PaperAirplaneIcon, PhotographIcon } from '@heroicons/react/outline';

type ChatMode = 'good' | 'pro' | 'hacker';
type MediaMode = 'text' | 'image' | 'both';

export default () => {
    const aiConfig = (window as any).AI_CONFIG || {};

    const [isOpen, setIsOpen] = useState<boolean>(false);
    const [isExpanded, setIsExpanded] = useState<boolean>(false);
    
    const [groqKey] = useState<string>(aiConfig.groq_key || localStorage.getItem('ai_groq_key') || '');
    const [aiName] = useState<string>(aiConfig.name || localStorage.getItem('ai_name') || 'VIZION AI');
    const [textModel] = useState<string>(aiConfig.text_model || localStorage.getItem('ai_text_model') || 'llama-3.3-70b-versatile');
    const [visionModel] = useState<string>(aiConfig.vision_model || localStorage.getItem('ai_vision_model') || 'llama-3.2-11b-vision-preview');

    const [chatMode, setChatMode] = useState<ChatMode>('good');
    const [mediaMode, setMediaMode] = useState<MediaMode>('both');
    const [messages, setMessages] = useState<any[]>([{ 
        sender: 'ai', 
        text: `Welcome to ${aiName} ✦\nPowered by SKA HOST. How can I assist you today?` 
    }]);
    
    const [input, setInput] = useState('');
    const [image, setImage] = useState<File | null>(null);
    const [imagePreview, setImagePreview] = useState<string | null>(null);
    const [loading, setLoading] = useState(false);
    
    const messagesEndRef = useRef<HTMLDivElement>(null);
    const fileInputRef = useRef<HTMLInputElement>(null);

    useEffect(() => {
        messagesEndRef.current?.scrollIntoView({ behavior: "smooth" });
    }, [messages, isOpen, isExpanded]);

    const handleModeChange = (mode: ChatMode) => {
        setChatMode(mode);
        const welcome = {
            'good': "Switched to GOOD Mode 🌟 (Friendly & Helpful)",
            'pro': "Switched to PRO Mode ⚡ (Architecture, Code & Math)",
            'hacker': "Switched to HACKER Mode 💀 (Hardcore Systems & Debugging)"
        };
        setMessages(prev => [...prev, { sender: 'ai', text: welcome[mode] }]);
    };

    const handleMediaModeChange = (mode: MediaMode) => {
        setMediaMode(mode);
        const welcome = {
            'text': "Mode: TEXT ONLY 📝",
            'image': "Mode: IMAGE ONLY 🎨 (Type any idea to render)",
            'both': "Mode: BOTH (Text + Concept Art) 🚀"
        };
        setMessages(prev => [...prev, { sender: 'ai', text: welcome[mode] }]);
    };

    const handleImageChange = (e: React.ChangeEvent<HTMLInputElement>) => {
        if (e.target.files && e.target.files[0]) {
            const file = e.target.files[0];
            setImage(file);
            const reader = new FileReader();
            reader.onloadend = () => setImagePreview(reader.result as string);
            reader.readAsDataURL(file);
        }
    };

    const sendMessage = async () => {
        if (!input.trim() && !image) return;

        const currentInput = input.trim();
        const newMessages = [...messages, { sender: 'user', text: currentInput, image: imagePreview }];
        setMessages(newMessages);
        setInput('');
        setImage(null);
        setImagePreview(null);
        setLoading(true);

        try {
            let finalImgUrl: string | undefined = undefined;
            const isImageTrigger = currentInput.toLowerCase().includes('generate') || currentInput.toLowerCase().includes('/imagine') || currentInput.toLowerCase().includes('image');
            const shouldGenImage = mediaMode === 'image' || mediaMode === 'both' || (isImageTrigger && mediaMode !== 'text');

            if (shouldGenImage) {
                let prompt = currentInput.replace(/^\/imagin[e]?\s*/i, '').replace(/generate/gi, '').trim();
                if (!prompt) prompt = "Futuristic high tech server system";
                const seed = Math.floor(Math.random() * 1000000);
                finalImgUrl = `https://image.pollinations.ai/prompt/${encodeURIComponent(prompt)}?width=1024&height=1024&nologo=true&seed=${seed}`;
            }

            if (mediaMode === 'image') {
                setTimeout(() => {
                    setMessages(prev => [...prev, { sender: 'ai', text: `✨ Generated art for "${currentInput}":`, generatedImage: finalImgUrl }]);
                    setLoading(false);
                }, 1200);
                return;
            }

            if (!groqKey) {
                setMessages(prev => [...prev, { sender: 'ai', text: '⚠️ Groq API Key is not set. Please set it in Admin Panel -> AI Settings.' }]);
                setLoading(false);
                return;
            }

            let systemPrompt = `You are ${aiName}, an advanced AI assistant created by SKA HOST.`;
            if (chatMode === 'hacker') systemPrompt += " Act as an elite reverse-engineering and hardcore cybersecurity expert. Provide raw, concise, high-level code.";
            if (chatMode === 'pro') systemPrompt += " Act as a Senior Software Architect and Mathematician. Deliver deep, accurate, structured logic.";
            if (chatMode === 'good') systemPrompt += " Act as a friendly, polite, empathetic, and highly resourceful guide.";

            let aiResponseText = "";
            const activeModel = imagePreview ? visionModel : textModel;

            const response = await fetch('https://api.groq.com/openai/v1/chat/completions', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${groqKey}` },
                body: JSON.stringify({ 
                    model: activeModel,
                    messages: [
                        { role: "system", content: systemPrompt },
                        { role: "user", content: imagePreview ? [
                            { type: "text", text: currentInput || `Analyze this image in ${chatMode.toUpperCase()} mode.` },
                            { type: "image_url", image_url: { url: imagePreview } }
                        ] : currentInput }
                    ]
                })
            });

            const data = await response.json();
            if (data.error) throw new Error(data.error.message);
            aiResponseText = data.choices[0].message.content;

            setMessages(prev => [...prev, { sender: 'ai', text: aiResponseText, generatedImage: finalImgUrl }]);

        } catch (error: any) {
            setMessages(prev => [...prev, { sender: 'ai', text: `Error: ${error.message}` }]);
        } finally {
            setLoading(false);
        }
    };

    return (
        <div className="fixed bottom-6 right-6 z-[9999] flex flex-col items-end font-sans select-none">
            {/* ULTRA MODERN NEON FLOATING BUTTON */}
            {!isOpen && (
                <button 
                    onClick={() => setIsOpen(true)}
                    className="group relative w-16 h-16 rounded-2xl bg-gradient-to-tr from-cyan-500 via-blue-600 to-indigo-700 p-0.5 shadow-[0_0_30px_rgba(37,99,235,0.6)] hover:shadow-[0_0_45px_rgba(6,182,212,0.9)] hover:scale-105 active:scale-95 transition-all duration-300"
                >
                    <div className="w-full h-full bg-[#080d1a]/80 backdrop-blur-md rounded-2xl flex items-center justify-center">
                        <ChatAlt2Icon className="w-8 h-8 text-cyan-400 group-hover:text-white transition-colors drop-shadow" />
                    </div>
                </button>
            )}

            {/* TRANSLUCENT GLASSMORPHIC CHAT CONTAINER */}
            {isOpen && (
                <div 
                    className={`relative w-[calc(100vw-2rem)] sm:w-[420px] bg-[#070b14]/85 backdrop-blur-2xl border border-white/10 shadow-[0_0_60px_rgba(0,0,0,0.8)] flex flex-col overflow-hidden transition-all duration-300 ${isExpanded ? 'fixed inset-3 sm:inset-10 rounded-3xl' : 'h-[640px] max-h-[85vh] rounded-3xl mb-2'}`}
                >
                    {/* Header */}
                    <div className="px-5 py-4 flex justify-between items-center border-b border-white/10 bg-white/[0.03] shrink-0">
                        <div className="flex items-center gap-3">
                            <div className="w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center shadow-lg border border-white/20">
                                <span className="font-extrabold text-white text-base tracking-wider">{aiName.charAt(0)}</span>
                            </div>
                            <div>
                                <h3 className="font-bold text-gray-100 text-base tracking-wide flex items-center gap-2">
                                    {aiName}
                                    <span className="text-[10px] bg-cyan-500/20 text-cyan-400 px-2 py-0.5 rounded-full border border-cyan-500/30">PRO</span>
                                </h3>
                                <div className="flex items-center gap-1.5 mt-0.5">
                                    <span className="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                                    <span className="text-[11px] text-gray-400">Powered by SKA HOST</span>
                                </div>
                            </div>
                        </div>
                        
                        <div className="flex items-center gap-1">
                            <button onClick={() => setIsExpanded(!isExpanded)} className="p-2 text-gray-400 hover:text-white hover:bg-white/10 rounded-xl transition-all">
                                {isExpanded ? <XIcon className="w-5 h-5" /> : <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path></svg>}
                            </button>
                            <button onClick={() => { setIsOpen(false); setIsExpanded(false); }} className="p-2 text-gray-400 hover:text-red-400 hover:bg-red-400/10 rounded-xl transition-all">
                                <XIcon className="w-6 h-6" />
                            </button>
                        </div>
                    </div>

                    {/* MODES TOGGLE */}
                    <div className="bg-white/[0.02] px-4 py-2.5 flex flex-col gap-2 shrink-0 border-b border-white/5">
                        <div className="flex bg-black/40 rounded-xl p-1 border border-white/5 gap-1">
                            {(['good', 'pro', 'hacker'] as ChatMode[]).map(m => (
                                <button key={m} onClick={() => handleModeChange(m)} className={`flex-1 text-[11px] uppercase tracking-wider py-1.5 rounded-lg font-bold transition-all duration-300 ${chatMode === m ? 'bg-gradient-to-r from-cyan-600 to-blue-600 text-white shadow-lg' : 'text-gray-400 hover:text-white'}`}>
                                    {m}
                                </button>
                            ))}
                        </div>
                        <div className="flex bg-black/40 rounded-xl p-1 border border-white/5 gap-1">
                            {(['text', 'image', 'both'] as MediaMode[]).map(m => (
                                <button key={m} onClick={() => handleMediaModeChange(m)} className={`flex-1 text-[11px] uppercase tracking-wider py-1.5 rounded-lg font-bold transition-all duration-300 ${mediaMode === m ? 'bg-gradient-to-r from-purple-600 to-pink-600 text-white shadow-lg' : 'text-gray-400 hover:text-white'}`}>
                                    {m}
                                </button>
                            ))}
                        </div>
                    </div>

                    {/* CHAT MESSAGES */}
                    <div className="flex-1 p-4 overflow-y-auto flex flex-col gap-4">
                        {messages.map((msg, idx) => (
                            <div key={idx} className={`flex ${msg.sender === 'user' ? 'justify-end' : 'justify-start'}`}>
                                <div className={`max-w-[85%] p-3.5 text-sm leading-relaxed ${
                                    msg.sender === 'user' 
                                    ? 'bg-gradient-to-br from-blue-600 to-indigo-700 text-white rounded-2xl rounded-tr-sm shadow-md' 
                                    : 'bg-white/10 text-gray-100 rounded-2xl rounded-tl-sm border border-white/10 backdrop-blur-md shadow-md'
                                }`}>
                                    {msg.image && <img src={msg.image} alt="Upload" className="max-w-full rounded-xl mb-2 border border-white/20" />}
                                    <div style={{ whiteSpace: 'pre-wrap' }}>{msg.text}</div>
                                    {msg.generatedImage && (
                                        <div className="mt-3 relative group rounded-xl overflow-hidden border border-white/10 bg-black/40 min-h-[160px] flex items-center justify-center">
                                            <img 
                                                src={msg.generatedImage} 
                                                alt="AI Generation" 
                                                className="w-full h-auto rounded-xl shadow-xl transition-all hover:scale-105" 
                                            />
                                        </div>
                                    )}
                                </div>
                            </div>
                        ))}
                        {loading && (
                            <div className="flex justify-start">
                                <div className="bg-white/10 border border-white/10 px-4 py-3 rounded-2xl rounded-tl-sm flex gap-2 items-center backdrop-blur-md">
                                    <div className="w-2 h-2 bg-cyan-400 rounded-full animate-bounce"></div>
                                    <div className="w-2 h-2 bg-blue-400 rounded-full animate-bounce" style={{ animationDelay: '0.2s' }}></div>
                                    <div className="w-2 h-2 bg-purple-400 rounded-full animate-bounce" style={{ animationDelay: '0.4s' }}></div>
                                </div>
                            </div>
                        )}
                        <div ref={messagesEndRef} />
                    </div>

                    {/* INPUT AREA */}
                    <div className="p-3 bg-white/[0.03] border-t border-white/10 shrink-0 backdrop-blur-xl">
                        <div className="flex items-end gap-2">
                            <input type="file" accept="image/*" className="hidden" ref={fileInputRef} onChange={handleImageChange} />
                            <button onClick={() => fileInputRef.current?.click()} className={`p-2.5 rounded-xl border transition-all ${image ? 'bg-emerald-500/20 text-emerald-400 border-emerald-500/40' : 'bg-black/40 text-gray-400 border-white/10 hover:text-white'}`}>
                                <PhotographIcon className="w-5 h-5" />
                            </button>
                            
                            <textarea 
                                value={input} 
                                onChange={(e) => setInput(e.target.value)} 
                                onKeyDown={(e) => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); } }}
                                placeholder={mediaMode === 'image' ? "Describe image to create..." : "Ask Vizion AI..."}
                                className="flex-1 bg-black/40 border border-white/10 rounded-xl px-3.5 py-2.5 text-sm text-white placeholder-gray-500 resize-none outline-none focus:border-cyan-500/60"
                                rows={isExpanded ? 2 : 1}
                            />
                            
                            <button onClick={sendMessage} disabled={loading || (!input.trim() && !image)} className="p-2.5 bg-gradient-to-tr from-cyan-500 to-blue-600 disabled:opacity-40 text-white rounded-xl shadow-lg">
                                <PaperAirplaneIcon className="w-5 h-5 transform rotate-90" />
                            </button>
                        </div>
                    </div>
                </div>
            )}
        </div>
    );
};
