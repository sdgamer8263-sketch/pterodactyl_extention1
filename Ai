                        <div className="flex items-center gap-1">
                            <button onClick={() => setIsMinimized(!isMinimized)} className="p-2 text-gray-400 hover:text-white hover:bg-white/10 rounded-xl" title="Minimize"><MinusIcon className="w-4 h-4" /></button>
