            let finalImgUrl: string | undefined = undefined;
            const isImgTrigger = currentInput.toLowerCase().includes('generate') || currentInput.toLowerCase().includes('/imagine');
            if (mediaMode === 'image' || mediaMode === 'both' || (isImgTrigger && mediaMode !== 'text')) {
                let prompt = currentInput.replace(/^\/imagin[e]?\s*/i, '').replace(/generate/gi, '').trim() || "Futuristic high tech server system";
                finalImgUrl = `https://image.pollinations.ai/prompt/${encodeURIComponent(prompt)}?width=1024&height=1024&nologo=true&seed=${Math.floor(Math.random() * 100000)}`;
            }
            if (mediaMode === 'image') {
                setTimeout(() => { setMessages(prev => [...prev, { sender: 'ai', text: `✨ Generated art:`, generatedImage: finalImgUrl }]); setLoading(false); }, 1200);
