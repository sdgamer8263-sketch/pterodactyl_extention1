                            <div>
                                <h3 className="font-bold text-gray-100 flex items-center gap-2">{aiConfig.name || 'AI'} <span className={`text-[10px] bg-black/40 ${theme.text} px-2 py-0.5 rounded-full border ${theme.border}`}>PRO</span></h3>
                                <div className="flex items-center gap-1.5 mt-0.5"><span className="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span><span className="text-[11px] text-gray-400">SKA HOST</span></div>
                            </div>
