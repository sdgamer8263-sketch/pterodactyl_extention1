            case 'royal': return { primary: 'from-purple-600 to-indigo-700', text: 'text-purple-400', border: 'border-purple-500/30' };
            case 'minimal': return { primary: 'from-gray-700 to-slate-800', text: 'text-gray-300', border: 'border-gray-500/30' };
            default: return { primary: 'from-cyan-500 to-blue-600', text: 'text-cyan-400', border: 'border-cyan-500/30' };
        }
    };
    const theme = getThemeStyles();

    return (
