const fs = require('fs');
const path = require('path'); 

const replacements = {
    'folder.create': 'Create Folder',
    'folder.update': 'Update Folder',
    'folder.edit': 'Edit Folder',
    'folder.name': 'Folder Name',
    'folder.color': 'Folder Color',
    'folder.icon': 'Folder Icon',
    'presets.title': 'Presets',
    'trashbin.title': 'Trashbin',
    'trashbin.deleted-at': 'Deleted At',
    'trashbin.restore': 'Restore',
    'trashbin.delete': 'Delete',
    'trashbin.delete-permanently': 'Delete Permanently',
    'trashbin.will-be-deleted': 'This item will be permanently deleted',
    'trashbin.select-all': 'Select All',
    'trashbin.selected': 'Selected',
    'account-settings': 'Account Settings',
    'update-email.change-email': 'Change Email',
    'filters.title': 'Filters',
    'general': 'General',
    'security': 'Security',
    'ssh-keys': 'SSH Keys',
    'api-keys': 'API Keys',
    'activity': 'Activity'
}; 

function walkSync(dir, filelist = []) {
    if (!fs.existsSync(dir)) return filelist;
    fs.readdirSync(dir).forEach(file => {
        const dirFile = path.join(dir, file);
        try { filelist = walkSync(dirFile, filelist); }
        catch (err) { if (err.code === 'ENOTDIR' || err.code === 'EBADF') filelist.push(dirFile); }
    });
    return filelist;
} 

const files = walkSync('/var/www/pterodactyl/resources/scripts').filter(f => f.endsWith('.tsx') || f.endsWith('.ts')); 

let patchedCount = 0;
files.forEach(file => {
    let content = fs.readFileSync(file, 'utf8');
    let original = content; 

    for (const [key, value] of Object.entries(replacements)) {
        const regex = new RegExp(`t\\(['"\`]${key}['"\`]\\)`, 'g');
        content = content.replace(regex, `"${value}"`);
    } 

    if (content !== original) {
        fs.writeFileSync(file, content, 'utf8');
        patchedCount++;
    }
}); 
