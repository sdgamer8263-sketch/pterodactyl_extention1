#!/bin/bash

# Colors for output
GREEN='\033[0;32m'
CYAN='\033[0;36m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# API URL for License Verification
API_URL="http://78.154.103.27:13915/api/verify"

# Spinner animation function
spin() {
    local pid=$1
    local delay=0.1
    local spinstr='|/-\'
    while [ "$(ps a | awk '{print $1}' | grep $pid)" ]; do
        local temp=${spinstr#?}
        printf " [%c]  " "$spinstr"
        local spinstr=$temp${spinstr%"$temp"}
        sleep $delay
        printf "\b\b\b\b\b\b"
    done
    printf "    \b\b\b\b"
}

echo -e "${CYAN}=====================================================${NC}"
echo -e "${GREEN}   Pterodactyl Premium Branding Customizer${NC}"
echo -e "${CYAN}=====================================================${NC}"
echo ""

# ---------------------------------------------------------
# Step 1: License Verification
# ---------------------------------------------------------
echo -e "${YELLOW}[*] License Verification Required${NC}"
read -p "Enter your Registered Email: " USER_EMAIL
read -p "Enter your License Key: " LICENSE_KEY

if [ -z "$USER_EMAIL" ] || [ -z "$LICENSE_KEY" ]; then
    echo -e "${RED}Error: Email and License Key cannot be empty!${NC}"
    exit 1
fi

echo -n -e "${CYAN}Verifying License with Server...${NC}"

# Making a POST request to the API
# NOTE: If your API expects GET request or form-data, you may need to adjust the curl command.
HTTP_STATUS=$(curl -s -o /dev/null -w "%{http_code}" -X POST -H "Content-Type: application/json" -d "{\"email\":\"$USER_EMAIL\", \"license_key\":\"$LICENSE_KEY\"}" "$API_URL")

if [ "$HTTP_STATUS" -eq 200 ]; then
    echo -e "${GREEN} [Verified Successfully!]${NC}\n"
else
    echo -e "\n${RED}Error: Invalid Email or License Key! (HTTP Status: $HTTP_STATUS)${NC}"
    echo -e "${RED}Access Denied. Exiting script...${NC}"
    exit 1
fi

# ---------------------------------------------------------
# Step 2: Branding Customization
# ---------------------------------------------------------
read -p "Enter your Hosting Name (e.g., CLOUDVEX): " HOSTING_NAME

if [ -z "$HOSTING_NAME" ]; then
    echo -e "${RED}Error: Hosting Name cannot be empty!${NC}"
    exit 1
fi

echo -e "\n${CYAN}[*] Starting branding update for: ${GREEN}$HOSTING_NAME${NC}\n"
cd /var/www/pterodactyl || { echo -e "${RED}Pterodactyl directory not found!${NC}"; exit 1; }

# Update Theme and Menu Names
echo -n -e "${YELLOW}Updating Theme and Menu Names...${NC}"
(
    find resources public -type f \( -name "*.php" -o -name "*.js" -o -name "*.tsx" -o -name "*.ts" \) -exec sed -i "s/Arix Editor/$HOSTING_NAME Editor/g" {} +
    find resources public -type f \( -name "*.php" -o -name "*.js" -o -name "*.tsx" -o -name "*.ts" \) -exec sed -i "s/Arix Theme/$HOSTING_NAME Theme/g" {} +
) >/dev/null 2>&1 &
spin $!
echo -e "${GREEN}Done!${NC}"

# Update Copyright Texts
echo -n -e "${YELLOW}Updating Copyright Texts...${NC}"
(
    find resources public -type f \( -name "*.php" -o -name "*.js" -o -name "*.tsx" -o -name "*.ts" \) -exec sed -i "s/Pterodactyl&reg;/$HOSTING_NAME/g" {} +
    find resources public -type f \( -name "*.php" -o -name "*.js" -o -name "*.tsx" -o -name "*.ts" \) -exec sed -i "s/Pterodactyl®/$HOSTING_NAME/g" {} +
    sed -i "s/Pterodactyl/$HOSTING_NAME/g" resources/scripts/components/elements/PageContentBlock.tsx 2>/dev/null
    sed -i "s/Pterodactyl/$HOSTING_NAME/g" resources/scripts/components/auth/LoginFormContainer.tsx 2>/dev/null
) >/dev/null 2>&1 &
spin $!
echo -e "${GREEN}Done!${NC}"

# Build Frontend Assets
echo -n -e "${YELLOW}Building frontend assets (This will take a few minutes)...${NC}"
(
    export NODE_OPTIONS=--openssl-legacy-provider
    yarn install
    yarn build:production
) >/dev/null 2>&1 &
spin $!
echo -e "${GREEN}Done!${NC}"

# Fix Permissions and Cache
echo -n -e "${YELLOW}Fixing permissions and clearing cache...${NC}"
(
    chown -R www-data:www-data /var/www/pterodactyl/*
    chown -R www-data:www-data /var/www/pterodactyl/.* 2>/dev/null
    php artisan view:clear
    php artisan cache:clear
    php artisan config:clear
) >/dev/null 2>&1 &
spin $!
echo -e "${GREEN}Done!${NC}"

echo -e "\n${GREEN}=====================================================${NC}"
echo -e "${GREEN} Success! Branding updated to $HOSTING_NAME.${NC}"
echo -e "${CYAN} Please clear your Cloudflare and Browser cache (CTRL+F5).${NC}"
echo -e "${GREEN}=====================================================${NC}"

