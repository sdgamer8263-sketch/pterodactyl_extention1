        const orderB = parseInt(customIcons[`${b.identifier}_order`], 10);
        
        const isNaN_A = isNaN(orderA);
        const isNaN_B = isNaN(orderB);
        
        if (isNaN_A && isNaN_B) return 0;
        if (isNaN_A) return 1; // Number chhara gulo niche jabe
        if (isNaN_B) return -1;
        
        return orderA - orderB; // 1, 2, 3 onujayi sajabe
    });

    return (
