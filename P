        if [[ $((count % 2)) -ne 0 ]]; then echo ""; fi

        echo -e "${CYAN} ──────────────────────────────────────────────────────────${NC}"
        echo -e " ${WHITE}Commands:${NC}"
        echo -e " ${YELLOW}1, 1,2, 1 2 3${NC} : Install specific addon(s)"
