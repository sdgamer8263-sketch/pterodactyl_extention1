                                    ref={ref}
                                    size={'invisible'}
                                    sitekey={recaptchaSettings.siteKey || '_invalid_key'}
                                    onVerify={(response) => {
                                        setToken(response);
                                        submitForm();
                                    }}
                                    onExpire={() => {
                                        setSubmitting(false);
                                        setToken('');
                                    }}
                                />
                            ) : (
                                recaptchaSettings.method === 'turnstile' && (
                                    <Turnstile
                                        sitekey={turnstileSettings.siteKey || '_invalid_key'}
                                        execution='render'
                                        appearance='always'
                                        onVerify={(response) => {
                                            setToken(response);
                                        }}
                                        onExpire={() => {
                                            setSubmitting(false);
                                            setToken('');
                                        }}
                                    />
                                )
                            ))}
                    </div>
                    <div css={tw`mt-3`}>
                        <Button type={'submit'} className={'w-full !py-3'} disabled={isSubmitting}>
                            {t('register.register')}
                        </Button>
                    </div>
                    <div css={tw`mt-6 text-center`}>
                        <Link
                            to={'/auth/login'}
                            css={tw`text-xs text-neutral-300 tracking-wide uppercase no-underline hover:text-neutral-200`}
                        >
                            {t('register.already-have-account')}
                        </Link>
                    </div>
                </RegisterFormContainer>
            )}
        </Formik>
    );
};

export default RegisterContainer;
