class SkaThemeController extends Controller {
    public function index(): View {
        \$settings = file_exists(storage_path('app/ska_theme.json')) ? json_decode(file_get_contents(storage_path('app/ska_theme.json')), true) : [];
        return view('admin.ska_theme', compact('settings'));
    }
    public function store(Request \$request) {
        \$data = \$request->except(['_token', 'bg_image_file']);
        \$oldSettings = file_exists(storage_path('app/ska_theme.json')) ? json_decode(file_get_contents(storage_path('app/ska_theme.json')), true) : [];
        \$data['bg_image'] = \$oldSettings['bg_image'] ?? '';

        // ফোল্ডার না থাকলে তৈরি করা
        if (!file_exists(public_path('assets/ska_theme'))) {
