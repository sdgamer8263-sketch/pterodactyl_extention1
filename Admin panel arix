        if (\$request->hasFile('bg_image_file')) {
            \$file = \$request->file('bg_image_file');
            \$filename = time() . '_' . \$file->getClientOriginalName();
            \$file->move(public_path('assets/ska_theme'), \$filename);
            \$data['bg_image'] = '/assets/ska_theme/' . \$filename;
        } elseif (\$request->filled('bg_image_link')) {
            \$data['bg_image'] = \$request->input('bg_image_link');
        }

        file_put_contents(storage_path('app/ska_theme.json'), json_encode(\$data));
        return redirect()->route('admin.ska_theme')->with('success', 'SKA Admin Theme updated perfectly!');
    }
}
